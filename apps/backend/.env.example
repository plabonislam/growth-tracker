# PostgreSQL connection — local Docker default
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsi_club

# Email of the user to promote to Authority via db:seed
SEED_EMAIL=your@dsinnovators.com

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-in-production

# Google OAuth credentials — create at console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
