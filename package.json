{
  "name": "pnpm_mono_shared",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev:shared": "pnpm --filter shared run build",
    "dev:backend": "pnpm run --filter backend start:dev",
    "dev:frontend": "pnpm run --filter frontend dev",
    "dev": "concurrently \"pnpm run dev:shared\" \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint && pnpm --filter shared lint",
    "type-check": "pnpm --filter backend type-check && pnpm --filter frontend type-check && pnpm --filter shared type-check",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.16.1",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.61.1",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.53.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
